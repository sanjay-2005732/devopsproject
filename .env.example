# Environment Configuration - Copy to .env and fill values
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studentdb
DB_USERNAME=root
DB_PASSWORD=your_password_here
DOCKER_IMAGE_NAME=student-management-app
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=your-dockerhub-username
JENKINS_URL=http://localhost:8081
GITHUB_REPO_URL=https://github.com/your-username/devopsproject.git
AWS_EC2_HOST=your-ec2-public-ip
AWS_EC2_USER=ec2-user
AWS_SSH_KEY_PATH=~/.ssh/your-key.pem

